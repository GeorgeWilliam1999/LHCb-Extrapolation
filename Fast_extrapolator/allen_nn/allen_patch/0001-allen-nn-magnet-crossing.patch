+    net.most_y = d.at("most_abs_y").get<float>();
+    if (j.contains("leg_step_mm")) net.leg_step = j.at("leg_step_mm").get<float>();
+    if (j.contains("network_jacobian")) net.network_jacobian = j.at("network_jacobian").get<int>();
