+// PROTOTYPE: checks of the magnet-crossing tool (K Nystrom steps + network) on a
+// synthetic field (z only), with no input data: (1) a network with zero last layer gives
+// the plain fixed-step Nystrom; (2) the transport matrix of the tool against
+// finite differences (a smooth field, double); (3) the polarity symmetry.
+
+#if __has_include(<catch2/catch.hpp>)
+#include <catch2/catch.hpp>
+#else
+#include <catch2/catch_test_macros.hpp>
+#endif
+
+#include <cmath>
+#include <memory>
+
+#include "../../../../device/kalman/ParKalman/include/allen_nn/magnet_crossing.h"
+
+namespace {
+  // a field that depends on z only, in the Gaudi unit (1 T = 1e-3), sign `s`. With no
+  // dependence on x and y the Nystrom matrix chained with the field held fixed (as the
+  // ARKN chains it) is the exact derivative of the scheme, so the whole matrix of the
+  // tool can be checked against finite differences.
+  struct ToyField {
+    double s = 1;
+    template<class R>
+    void operator()(R, R, R z, R& bx, R& by, R& bz) const
+    {
+      const R g = std::exp(-((z - R(5000)) * (z - R(5000))) / R(2 * 1500. * 1500.));
+      by = R(s) * R(-1.0e-3) * g;
+      bx = R(s) * R(5e-5) * g;
+      bz = R(s) * R(2e-5) * g;
+    }
+  };
+
+  template<class R>
+  std::unique_ptr<allen_nn::CrossingNetwork<R>> toy_network(bool zero_last)
+  {
+    auto net = std::make_unique<allen_nn::CrossingNetwork<R>>();
+    net->steps = 8, net->depth = 2, net->width = 8;
+    net->z0 = R(2648.2), net->z1 = R(7826.);
+    for (int i = 0; i <= 8; ++i)
+      net->planes[i] = R(2648.2 + i * ((7826. - 2648.2) / 8));
+    const double in[5] = {180, 175, 0.07, 0.07, 0.06}, out[4] = {0.015, 0.002, 1.3e-5, 1.9e-6};
+    for (int a = 0; a < 5; ++a)
+      net->inv_scale_in[a] = R(1 / in[a]);
+    for (int a = 0; a < 4; ++a)
+      net->scale_out[a] = R(out[a]);
+    net->inv_scale_qop = R(1 / 0.06);
+    net->most_qop = R(0.3), net->most_tx = R(1), net->most_ty = R(1), net->most_x = R(1000), net->most_y = R(1000);
+    for (int i = 0; i < 8 * 5; ++i)
+      net->W_first[i] = R(0.3 * std::sin(1.7 * i + 0.3));
+    for (int i = 0; i < 8; ++i)
+      net->b_first[i] = R(0.1 * std::cos(2.3 * i));
+    for (int i = 0; i < 64; ++i)
+      net->W_hidden[0][i] = R(0.25 * std::sin(0.9 * i + 1.1));
+    for (int i = 0; i < 8; ++i)
+      net->b_hidden[0][i] = R(0.05 * std::sin(3.1 * i));
+    for (int i = 0; i < 32; ++i)
+      net->W_last[i] = zero_last ? R(0) : R(0.5 * std::cos(1.3 * i + 0.2));
+    for (int i = 0; i < 4; ++i)
+      net->b_last[i] = zero_last ? R(0) : R(0.1 * i);
+    return net;
+  }
+} // namespace
+
+TEST_CASE("magnet crossing: zero network is the fixed Nystrom", "[magnet_nn]")
+{
+  auto net = toy_network<double>(true);
+  ToyField field;
+  const double qop = 1.0 / 5000.; // 5 GeV, 1/MeV
+  double x[5] = {100, 50, 0.04, 0.02, qop}, J[5][5];
+  bool ok = true;
+  REQUIRE(allen_nn::propagate_magnet<double, true>(*net, x, J, 2648.2, 7826., field, 1., ok));
+  REQUIRE(ok);
+  double s[5] = {100, 50, 0.04, 0.02, qop * double(allen_nn::c_light)}, B0[3];
+  field(s[0], s[1], 2648.2, B0[0], B0[1], B0[2]);
+  allen_nn::nystrom_fixed(s, net->planes, 8, B0, field, (double(*)[5]) nullptr);
+  for (int i = 0; i < 4; ++i)
+    REQUIRE(std::abs(x[i] - s[i]) <= 1e-12 * (1 + std::abs(s[i])));
+}
+
+TEST_CASE("magnet crossing: transport matrix against finite differences", "[magnet_nn]")
+{
+  auto net = toy_network<double>(false);
+  ToyField field;
+  const double s0[5] = {120, -60, 0.05, -0.03, 1.0 / 4000.};
+  double x[5], J[5][5];
+  for (int i = 0; i < 5; ++i)
+    x[i] = s0[i];
+  bool ok = true;
+  REQUIRE(allen_nn::propagate_magnet<double, true>(*net, x, J, 2630., 7850., field, 1., ok));
+  const double h[5] = {1e-3, 1e-3, 1e-6, 1e-6, 1e-9};
+  for (int j = 0; j < 5; ++j) {
+    double p[5], m[5], dummy[5][5];
+    for (int i = 0; i < 5; ++i)
+      p[i] = m[i] = s0[i];
+    p[j] += h[j], m[j] -= h[j];
+    bool okp = true, okm = true;
+    allen_nn::propagate_magnet<double, false>(*net, p, dummy, 2630., 7850., field, 1., okp);
+    allen_nn::propagate_magnet<double, false>(*net, m, dummy, 2630., 7850., field, 1., okm);
+    for (int i = 0; i < 4; ++i) {
+      const double fd = (p[i] - m[i]) / (2 * h[j]);
+      const double tolerance = 1e-6 * (std::abs(fd) + 1e-3 * std::abs(J[i][j])) + 1e-9;
+      INFO("row " << i << " column " << j << " matrix " << J[i][j] << " finite difference " << fd);
+      REQUIRE(std::abs(J[i][j] - fd) <= tolerance);
+    }
+  }
+}
+
+TEST_CASE("magnet crossing: polarity symmetry", "[magnet_nn]")
+{
+  auto net = toy_network<float>(false);
+  ToyField up {1}, down {-1};
+  float a[5] = {80, 40, 0.03, 0.015, 1.f / 6000.f}, b[5] = {80, 40, 0.03, 0.015, -1.f / 6000.f};
+  float Ja[5][5], Jb[5][5];
+  bool oka = true, okb = true;
+  allen_nn::propagate_magnet<float, true>(*net, a, Ja, 2648.2f, 7826.f, up, 1.f, oka);
+  allen_nn::propagate_magnet<float, true>(*net, b, Jb, 2648.2f, 7826.f, down, -1.f, okb);
+  for (int i = 0; i < 4; ++i) {
+    REQUIRE(a[i] == b[i]);
+    for (int j = 0; j < 4; ++j)
+      REQUIRE(Ja[i][j] == Jb[i][j]);
+    REQUIRE(Ja[i][4] == -Jb[i][4]);
+  }
+}
