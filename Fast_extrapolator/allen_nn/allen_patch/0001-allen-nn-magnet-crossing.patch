+* or submit itself to any jurisdiction.                                       *
+\*****************************************************************************/
+#pragma once
+
+// PROTOTYPE (not for merging as is): the magnet crossing of PrKF through
+// "K fixed Nystrom steps + one network correction" instead of the adaptive RKN.
+// The tool itself is allen_nn/magnet_crossing.h (plain functions, shared with the
+// standalone checks of the RK-PINN project); this file adds the field adapter, the
+// call in the form of ARKN::propagate_jac and the host-side loader of the weights.
+
+#include "BackendCommon.h"
+#include "MagneticField.cuh"
+#include "ExtrapolatorCommon.cuh"
+
+#ifndef ALLEN_NN_HD
+#define ALLEN_NN_HD __host__ __device__
+#endif
+#include "allen_nn/magnet_crossing.h"
+
+namespace MagnetCrossingNN {
+
+  using Network = allen_nn::CrossingNetwork<float>;
+
+  struct MagfieldAdapter {
+    const MagneticField::Magfield& field;
+    __device__ void operator()(float x, float y, float z, float& bx, float& by, float& bz) const
+    {
+      const float3 B = field.fieldVectorLinearInterpolation(float3 {x, y, z});
+      bx = B.x;
+      by = B.y;
+      bz = B.z;
+    }
+  };
+
+  // As ARKN::propagate_jac. Returns false (nothing changed) when the state is outside
+  // the domain of the network; the caller then calls the ARKN.
+  __device__ inline bool propagate_jac(
+    const Network& net,
+    KalmanFilter::Vector5& state,
+    Extrapolators::State::Jacobian& jacobian,
+    const float z_in,
+    const float z_out,
+    const MagneticField::Magfield& field,
+    const float polarity,
+    bool& fit_success)
+  {
+    float x[5] = {state[0], state[1], state[2], state[3], state[4]};
+    float J[5][5];
+    const bool done =
+      allen_nn::propagate_magnet<float, true>(net, x, J, z_in, z_out, MagfieldAdapter {field}, polarity, fit_success);
+    if (!done || !fit_success) return done;
+    for (int i = 0; i < 4; ++i)
+      state[i] = x[i];
+    for (int i = 0; i < 5; ++i)
+      for (int j = 0; j < 5; ++j)
+        jacobian.jacobian(i, j) = J[i][j];
+    return true;
+  }
+
+} // namespace MagnetCrossingNN
